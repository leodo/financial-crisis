# Financial Crisis API 环境变量
# 部署时按实际路径和网络修改

# 数据存储模式: sqlite | postgres
FC_DATA_MODE=sqlite

# SQLite 数据库路径 (DataMode=sqlite 时使用)
FC_SQLITE_PATH=/opt/financial-crisis/data/fc-local.sqlite

# API 监听地址
FC_BIND_ADDRESS=127.0.0.1:18080

# 外部 API 基础 URL (用于 nginx 反代)
# FC_PUBLIC_URL=https://crisis.example.com

# 日志级别
RUST_LOG=info
# RUST_LOG=fc_api=debug,fc_worker=info

# 前端构建产物目录 (用于内嵌 web 服务)
FC_WEB_DIST=/opt/financial-crisis/current/web/dist

# 刷新后 API reload URL
FC_API_RELOAD_URL=http://127.0.0.1:18080/api/system/reload

# 运维告警推送（默认不配置即不发送，只保留日志/报告）
# 通用 JSON webhook，会发送结构化 payload；如需鉴权可配置 bearer token。
# FC_ALERT_WEBHOOK_URL=https://example.com/financial-crisis-alert
# FC_ALERT_WEBHOOK_BEARER_TOKEN=

# 常见 IM webhook，可按需要只启用一个。
# FC_ALERT_SLACK_WEBHOOK_URL=
# FC_ALERT_FEISHU_WEBHOOK_URL=
# FC_ALERT_DINGTALK_WEBHOOK_URL=

# 默认只在异常时发送；如需每次成功也发送，设为 1。
# FC_ALERT_ON_SUCCESS=0
# FC_ALERT_TIMEOUT_MS=10000
# FC_ALERT_DRY_RUN=0

# 业务层风险阈值提醒（默认只提醒，不自动交易）
# FC_RUN_RISK_THRESHOLD_AFTER_REFRESH=1
# FC_RISK_ALERT_OVERALL_SCORE=55
# FC_RISK_ALERT_TRIGGER_SCORE=60
# FC_RISK_ALERT_MIN_POSTURE=prepare
# FC_RISK_ALERT_MAX_SOURCE_ISSUES=0
# FC_RISK_ALERT_ON_REFERENCE_ONLY=0
